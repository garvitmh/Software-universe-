# ── Software Universe — environment ─────────────────────────────────────────
# Copy to `.env.local` (dev) or set in your host (Vercel → Project → Settings →
# Environment Variables) to enable the AI assistant for ALL visitors.
#
# The assistant degrades gracefully: with NO key set it still answers from a
# local template and never errors — but real Socratic answers need a key below.

# Recommended: OpenRouter (has free models, one key works for everyone).
# Get a key at https://openrouter.ai/keys  (free tier available).
OPENROUTER_API_KEY=

# Optional: pin a specific OpenRouter model. Defaults to a free Llama-3.3-70B.
# Browse models at https://openrouter.ai/models?max_price=0  (look for ":free").
OPENROUTER_MODEL=

# Alternative: a standard OpenAI key (used only if OPENROUTER_API_KEY is unset).
OPENAI_API_KEY=
